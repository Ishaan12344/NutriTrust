# Required only for the OCR endpoint. The health and barcode endpoints can run without it.
SARVAM_API_KEY=replace-with-your-sarvam-api-key

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nutritrust

# Optional operational settings.
NUTRITRUST_OFF_USER_AGENT=NutriTrust/0.1 (contact: you@example.com)
NUTRITRUST_MAX_IMAGE_SIZE_BYTES=10485760
NUTRITRUST_SARVAM_TIMEOUT_SECONDS=180
NUTRITRUST_SARVAM_DOWNLOAD_TIMEOUT_SECONDS=60
NUTRITRUST_OFF_TIMEOUT_SECONDS=10

# Optional local summary model (Qwen2.5-1.5B-Instruct under backend/models).
# Set NUTRITRUST_SUMMARY_ENABLED=false to skip the /api/v1/summary endpoint.
NUTRITRUST_SUMMARY_ENABLED=true
NUTRITRUST_SUMMARY_MAX_NEW_TOKENS=320
NUTRITRUST_SUMMARY_TIMEOUT_SECONDS=120
# NUTRITRUST_SUMMARY_MODEL_PATH=D:/Projects/NutriTrust/backend/models/Qwen2.5-1.5B-Instruct
